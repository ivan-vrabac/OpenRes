# Copy to .env (gitignored) and adjust. Never commit .env.

# Host interface/port the server is published on. Keep 127.0.0.1 behind a reverse proxy;
# use 0.0.0.0 only for LAN testing with a phone.
BIND_ADDRESS=127.0.0.1
SERVER_PORT=8000

# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs, or * only
# if the container is unreachable except through your proxy).
FORWARDED_ALLOW_IPS=127.0.0.1

# Accounts & sessions (see SECURITY.md)
#   secure = company name + password, server-signed sessions (default)
#   mixed  = transition: passwords for new apps, name-only still works for old apps and
#            for accounts that have not set a password yet (use with AUTH_LEGACY_CLAIM=1)
#   legacy = original name-only login; ONLY for private servers with trusted players
AUTH_MODE=secure
# Key that signs session tokens. Empty = generated once and stored in the database.
# Changing it signs everyone out. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_DAYS=90
# 1 = accounts created before passwords existed get the password used at their first sign-in.
AUTH_LEGACY_CLAIM=0

# Identifier reported to legacy clients in configGetData.

# Firebase Cloud Messaging (optional, see docs/FIREBASE.md)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
